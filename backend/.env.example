# PostgreSQL connection
DATABASE_URL="postgresql://uniconnect:uniconnect@localhost:5432/uniconnect?schema=public"

# Long random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=4000

# The public address phones use to reach this server (used for uploaded file links).
# On a phone on the same Wi-Fi, use your computer's LAN IP, e.g. http://192.168.1.20:4000
PUBLIC_URL="http://localhost:4000"

# Comma-separated list of web origins allowed to call the API ("*" during development).
CORS_ORIGINS="*"

# Google sign-in: OAuth client IDs from Google Cloud Console (web, Android, iOS), comma-separated.
# Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_IDS=""

# Live video (LiveKit). Use LiveKit Cloud (free tier at livekit.io) or run your own server.
# For local testing: run `livekit-server --dev` and use the values below.
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# Serve the website from this server: build it with `cd mobile && npx expo export -p web`,
# then point WEB_DIST at mobile/dist. WEB_URL is the website's public address.
WEB_DIST=""
WEB_URL="http://localhost:8081"
