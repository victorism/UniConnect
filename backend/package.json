{
  "name": "uniconnect-api",
  "version": "0.1.0",
  "private": true,
  "description": "UniConnect backend: REST API + real-time engagement server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "admin:create": "tsx scripts/make-super-admin.ts",
    "test:smoke2": "tsx scripts/smoke-test-phase2.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.19.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
